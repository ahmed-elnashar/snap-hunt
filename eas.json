{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://snap-hunt.expo.app"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true, "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://snap-hunt.expo.app",
        "EXPO_PUBLIC_E2E": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://snap-hunt.expo.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://snap-hunt.expo.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
