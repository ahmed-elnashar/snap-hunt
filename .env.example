# Copy to .env for local development. .env is gitignored and must stay that way.

# ---------------------------------------------------------------------------
# SERVER ONLY. Read by app/api/judge+api.ts and by nothing else, ever.
# Never prefix this with EXPO_PUBLIC_ — that prefix inlines a value into the
# client bundle. CI greps the built bundle for this key and fails on a hit.
#
# In EAS Hosting this must be created with visibility "sensitive", NOT
# "secret": EAS Hosting cannot deploy secret-visibility variables and the route
# silently receives undefined.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me

# ---------------------------------------------------------------------------
# CLIENT. Safe to inline — it is an address, not a credential.
# In local development this is the Metro dev server printed by `npx expo start`
# (use the LAN address, not localhost, when running on a physical device).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.1.10:8082

# Set to 1 only for Maestro runs on the simulator, which has no camera. Swaps
# the live preview for a bundled fixture photograph. Never set in a real build.
# EXPO_PUBLIC_E2E=0
